{
  "name": "project-viewer",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "main": "plugin.ts",
  "scripts": {
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter viewer-server run dev",
    "dev:client": "pnpm --filter viewer-client run dev",
    "dev": "pnpm -r --parallel run dev"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
